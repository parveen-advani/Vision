# Server only. Leave empty for command parsing and curated presentation guides.
# Never prefix an API key with VITE_.
OPENAI_API_KEY=
# Existing command interpreter model (independent from the presentation copilot).
OPENAI_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_MODEL=gpt-6-luna
# Set false to disable paid copilot requests even when a key is configured.
VISION_AI_ENABLED=true

# Development only: put this in .env.development.local. Leave unset in production.
VITE_AI_API_URL=http://localhost:8000
